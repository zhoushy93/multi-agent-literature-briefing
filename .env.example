# Copy to .env and fill in real values. Never commit .env.
# Provider credentials use the provider's own variable names (no BRIEFING_ prefix).
DEEPSEEK_API_KEY=

# Project configuration. All of these are read through src/briefing/config.py
# with the BRIEFING_ prefix (AGENTS.md §9).
#
# Model ids this account actually offers (verified 2026-09-17):
#   deepseek-v4-pro   the flagship model this project is built around
#   deepseek-flash    a faster, cheaper alternative
BRIEFING_DEEPSEEK_MODEL=
BRIEFING_DEEPSEEK_BASE_URL=
BRIEFING_DEEPSEEK_MODEL_REASONING=
# Both available models think before answering. Those thinking tokens are
# billed as output and can eat the whole reply budget, so they are disabled by
# default; set "auto" to let the model reason (slower, dearer, truncation-prone).
BRIEFING_DEEPSEEK_THINKING=disabled
BRIEFING_MAX_CONCURRENCY=4
BRIEFING_MAX_LLM_CALLS=40
BRIEFING_MAX_TOKENS_BUDGET=400000
# How many candidates reach the screener (AGENTS.md §7 keeps this small: a
# huge prompt is slow, expensive, and gets truncated by the output limit).
BRIEFING_MAX_CANDIDATES=40
# Per-reply output ceiling. Raise it if a reply is cut off.
BRIEFING_MAX_OUTPUT_TOKENS=8192

# live  -> call the real API
# stub  -> replay fixtures from BRIEFING_FIXTURES_DIR (offline tests, see TASK.md Step 14)
BRIEFING_LLM_MODE=live
BRIEFING_FIXTURES_DIR=

# Enables the LLM-based semantic layer of the verifier (TASK.md Step 11).
BRIEFING_VERIFY_SEMANTIC=0
